<?xml version="1.0" encoding="utf-8"?>
<!-- Today at a glance: your why on Noto's banner, the progress, and up to 3 habits to tick. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/w_banner"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <ImageView
            android:id="@+id/w_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_banner_normal" />
        <TextView
            android:id="@+id/w_why"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="60dp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:gravity="top|start"
            android:lineSpacingMultiplier="1.0"
            android:maxLines="3"
            android:shadowColor="#33000000"
            android:shadowDy="2"
            android:shadowRadius="0.01"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold|italic" />
        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/widget_pill"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="#E8542A"
            android:textSize="10sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/w_noto"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_sticker_normal" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/w_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <!-- every habit, scrolling (rows: noto_widget_row.xml, filled by NotoWidgetService) -->
        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Tap to add a habit in Ultradian"
            android:textColor="@color/widget_soft"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
