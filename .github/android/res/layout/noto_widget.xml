<?xml version="1.0" encoding="utf-8"?>
<!-- Today at a glance: your why on Noto's banner, the progress, and up to 3 habits to tick. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/w_banner"
        android:layout_width="match_parent"
        android:layout_height="70dp">
        <ImageView
            android:id="@+id/w_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_banner_normal" />
        <TextView
            android:id="@+id/w_why"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="60dp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="0.5sp"
            android:autoSizeTextType="uniform"
            android:gravity="top|start"
            android:lineSpacingMultiplier="1.0"
            android:maxLines="3"
            android:shadowColor="#33000000"
            android:shadowDy="2"
            android:shadowRadius="0.01"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold|italic" />
        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/widget_pill"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="#E8542A"
            android:textSize="10sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/w_noto"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_sticker_normal" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/w_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:id="@+id/w_row0"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/widget_row_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="5dp"
            android:paddingBottom="3dp">
            <TextView
                android:id="@+id/w_name0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/w_btn0"
                android:layout_width="24dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_btn_orange" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row1"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_row_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="5dp"
            android:paddingBottom="3dp">
            <TextView
                android:id="@+id/w_name1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/w_btn1"
                android:layout_width="24dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_btn_orange" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_row2"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_row_orange"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="5dp"
            android:paddingBottom="3dp">
            <TextView
                android:id="@+id/w_name2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/w_btn2"
                android:layout_width="24dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_btn_orange" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_soft"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
